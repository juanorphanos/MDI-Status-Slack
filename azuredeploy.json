{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "logicAppName": {
      "type": "string",
      "defaultValue": "send-notification-mdi",
      "metadata": {
        "description": "Name of the Logic App workflow."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for the Logic App and API connection."
      }
    },
    "slackConnectionName": {
      "type": "string",
      "defaultValue": "slack",
      "metadata": {
        "description": "Name of the Slack API connection resource."
      }
    },
    "slackConnectionDisplayName": {
      "type": "string",
      "defaultValue": "Slack Connection",
      "metadata": {
        "description": "Display name for the Slack API connection."
      }
    },
    "slackChannelId": {
      "type": "string",
      "metadata": {
        "description": "Slack channel ID where notifications will be posted."
      }
    },
    "timeZone": {
      "type": "string",
      "defaultValue": "Argentina Standard Time",
      "metadata": {
        "description": "Time zone used by the recurrence trigger."
      }
    },
    "recurrenceFrequency": {
      "type": "string",
      "defaultValue": "Day",
      "allowedValues": [
        "Second",
        "Minute",
        "Hour",
        "Day",
        "Week",
        "Month"
      ],
      "metadata": {
        "description": "Recurrence frequency for the trigger."
      }
    },
    "recurrenceInterval": {
      "type": "int",
      "defaultValue": 1,
      "minValue": 1,
      "metadata": {
        "description": "Recurrence interval for the trigger."
      }
    }
  },
  "variables": {
    "slackManagedApiId": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', parameters('location'), '/managedApis/slack')]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[parameters('slackConnectionName')]",
      "location": "[parameters('location')]",
      "properties": {
        "displayName": "[parameters('slackConnectionDisplayName')]",
        "api": {
          "id": "[variables('slackManagedApiId')]"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2017-07-01",
      "name": "[parameters('logicAppName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', parameters('slackConnectionName'))]"
      ],
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "defaultValue": {},
              "type": "Object"
            }
          },
          "triggers": {
            "Recurrence": {
              "type": "Recurrence",
              "recurrence": {
                "interval": "@parameters('recurrenceInterval')",
                "frequency": "@parameters('recurrenceFrequency')",
                "timeZone": "@parameters('timeZone')"
              }
            }
          },
          "actions": {
            "HTTP": {
              "runAfter": {},
              "type": "Http",
              "inputs": {
                "uri": "https://graph.microsoft.com/beta/security/secureScores",
                "method": "GET",
                "authentication": {
                  "type": "ManagedServiceIdentity",
                  "audience": "https://graph.microsoft.com"
                }
              },
              "runtimeConfiguration": {
                "contentTransfer": {
                  "transferMode": "Chunked"
                }
              }
            },
            "Compose": {
              "runAfter": {
                "HTTP": [
                  "Succeeded"
                ]
              },
              "type": "Compose",
              "inputs": "@body('HTTP')['value']?[0]"
            },
            "Compose_1": {
              "runAfter": {
                "Compose": [
                  "Succeeded"
                ]
              },
              "type": "Compose",
              "inputs": "@outputs('Compose')['controlScores']"
            },
            "Parse_JSON": {
              "runAfter": {
                "Compose_1": [
                  "Succeeded"
                ]
              },
              "type": "ParseJson",
              "inputs": {
                "content": "@outputs('Compose_1')",
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "controlCategory": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "controlName": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "description": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "score": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "lastSynced": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "implementationStatus": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "on": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "scoreInPercentage": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "count": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "total": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "state": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "controlCategory",
                      "controlName"
                    ]
                  }
                }
              }
            },
            "Filter_array_1": {
              "runAfter": {
                "Parse_JSON": [
                  "Succeeded"
                ]
              },
              "type": "Query",
              "inputs": {
                "from": "@body('Parse_JSON')",
                "where": "@equals(item()['controlCategory'], 'Identity')"
              }
            },
            "Filter_array": {
              "runAfter": {
                "Filter_array_1": [
                  "Succeeded"
                ]
              },
              "type": "Query",
              "inputs": {
                "from": "@body('Filter_array_1')",
                "where": "@less(item()['scoreInPercentage'], 100)"
              }
            },
            "For_each": {
              "runAfter": {
                "Filter_array": [
                  "Succeeded"
                ]
              },
              "type": "Foreach",
              "foreach": "@body('Filter_array')",
              "actions": {
                "HTTP_1": {
                  "type": "Http",
                  "inputs": {
                    "uri": "https://graph.microsoft.com/beta/security/secureScoreControlProfiles?$filter=id eq '@{items('For_each')['controlName']}'",
                    "method": "GET",
                    "authentication": {
                      "type": "ManagedServiceIdentity",
                      "audience": "https://graph.microsoft.com"
                    }
                  },
                  "runtimeConfiguration": {
                    "contentTransfer": {
                      "transferMode": "Chunked"
                    }
                  }
                },
                "Post_message_(V2)": {
                  "runAfter": {
                    "HTTP_1": [
                      "Succeeded"
                    ]
                  },
                  "type": "ApiConnection",
                  "inputs": {
                    "host": {
                      "connection": {
                        "name": "@parameters('$connections')['slack']['connectionId']"
                      }
                    },
                    "method": "post",
                    "path": "/v2/chat.postMessage",
                    "body": {
                      "channel": "@parameters('slackChannelId')",
                      "text": "--------------------------------------------------------------\nDefender for Identity and Entra Controls\n\nIdentity Control Pending Remediation - @{body('HTTP_1')?['value'][0]?['title']}\n\nDescripción del issue\n\n@{items('For_each')?['description']}\n\nIr a Portal Defender XDR - https://security.microsoft.com/exposure-recommendations?tabId=Identities\n\n--------------------------------------------------------------"
                    }
                  }
                }
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "slack": {
                "id": "[variables('slackManagedApiId')]",
                "connectionId": "[resourceId('Microsoft.Web/connections', parameters('slackConnectionName'))]",
                "connectionName": "[parameters('slackConnectionName')]",
                "connectionProperties": {}
              }
            }
          }
        }
      }
    }
  ],
  "outputs": {
    "logicAppName": {
      "type": "string",
      "value": "[parameters('logicAppName')]"
    },
    "slackConnectionResourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Web/connections', parameters('slackConnectionName'))]"
    }
  }
}
